# --- Required: TMDB (movie data, posters, genres, ratings, trailers, watch providers) ---
# Get a free API key at https://www.themoviedb.org/settings/api (choose "API Key (v3 auth)")
TMDB_API_KEY=

# Alternative to TMDB_API_KEY: a v4 Read Access Token (Bearer). If set, it takes priority.
# TMDB_ACCESS_TOKEN=

# --- Optional but recommended: an LLM to turn free-text prompts into structured search
# preferences and to write the editorial "why this matches" copy. Without either key set,
# the app falls back to a bilingual (Hebrew/English) keyword parser and template copy —
# results still come from live TMDB queries, just without LLM-authored language understanding.
# Set ONE of the following. If both are set, Anthropic is used.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Optional: absolute site URL, used for Open Graph / share metadata.
# On Vercel this is inferred automatically from VERCEL_URL if left unset.
# NEXT_PUBLIC_SITE_URL=https://your-deployment.vercel.app
